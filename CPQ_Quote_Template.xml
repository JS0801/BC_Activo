<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdfset>
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
	<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
	<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
	<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
	<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
	</#if>
    <macrolist>

        <macro id="mainheader">
            <table class="header">
                <tr>
                    <!-- Red banner: left of logo -->
                    <td style="width: 6.30in; padding-left: 3px; vertical-align: middle;">
                        <table style="width: 100%; height: .9in; background-color: #b93c3c;">
                            <tr>
                                <td align="left" style="padding: 0.10in 0.25in 0.08in 20px;
                                                        color: #ffffff;
                                                        vertical-align: middle;">
                                    <span style="font-size: 11pt; font-weight: bold;">
                                        ${subsidiary.mainaddress_text}
                                    </span><br />
                                </td>
                            </tr>
                        </table>
                    </td>

                    <!-- Logo card -->
                    <td align="center" valign="middle"
                        style="width: 2in; height: 1.45in; padding: 0;
                            background-color: #eeeeee;">
                        <#if companyInformation.logoUrl?length != 0>
                            <@filecabinet
                                nstype="image"
                                src="${companyInformation.logoUrl}"
                                style="height: 25%; width: 25%" />
                        </#if>
                    </td>

                    <!-- Red banner: visible to the right of the logo -->
                    <td style="width: 0.25in; padding-right: 3px; vertical-align: middle;">
                        <table style="width: 100%; height: .9in; background-color: #b93c3c;">
                            <tr>
                                <td style="padding: 0;">&#160;</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </macro>

        <macro id="mainfooter">
            <table class="footer" style="width: 100%;">
                <tr>
                    <td colspan="2" style="height: .05in; background-color: #b93c3c;">&#160;</td>
                </tr>
                <tr>
                    <td align="left" style="font-size: 10pt;padding-left: 20px; vertical-align: middle;height: .5in; background-color: #eeeeee;">
                        Quote # ${record.tranid}
                    </td>
                    <td align="right" style="font-size: 10pt;padding-right: 15px; vertical-align: middle;height: .5in; background-color: #eeeeee;">
                        Page: <pagenumber/> of <totalpages/>
                    </td>
                </tr>
            </table>
        </macro>

        <macro id="firstpageheader">
            <table class="footer" style="width: 100%;">
                <tr>
                    <td>
                        <img style="height: 65%;width: 65%" src="https://8488975-sb1.app.netsuite.com/core/media/media.nl?id=13385&amp;c=8488975_SB1&amp;h=lTkeBCQjU1oRuyGIcyN6n0SYPRiHF-K5P6cvukZ0R-P8kZEa"></img>
                    </td>
                </tr>
            </table>
        </macro>

        <macro id="firstpagefooter">
            <table class="footer" style="width: 100%;">
                <tr>
                    <td style="border-right: 2px solid black; width: 25%;"></td>
                    <td style="width: 75%;">
                        <p style="text-align: center; padding-left: 20px; padding-right: 20px;">This document is the property of Activo, Inc. and is not to be discloded, copied, distributed or made public without prior written approval from Activo Inc.</p>
                    </td>
                    <td style="border-left: 2px solid black; width: 25%;">
                    </td>
                </tr>
            </table>
        </macro>

        <macro id="blankHeader">
            <!-- intentionally empty -->
        </macro>
    </macrolist>

    <style>
		* {
		<#if .locale == "zh_CN">
			font-family: NotoSans, NotoSansCJKsc, sans-serif;
		<#elseif .locale == "zh_TW">
			font-family: NotoSans, NotoSansCJKtc, sans-serif;
		<#elseif .locale == "ja_JP">
			font-family: NotoSans, NotoSansCJKjp, sans-serif;
		<#elseif .locale == "ko_KR">
			font-family: NotoSans, NotoSansCJKkr, sans-serif;
		<#elseif .locale == "th_TH">
			font-family: NotoSans, NotoSansThai, sans-serif;
		<#else>
			font-family: NotoSans, sans-serif;
		</#if>
		}

        body {
            font-size: 9pt;
        }

        body > p,
        body > ul,
        body > ol,
        body > pre,
        body > table,
        body > h1,
        body > h2,
        body > h3,
        body > h4 {
            margin-left: 0.5in;
            margin-right: 0.5in;
        }

        /* Prevent nested lists from accumulating another 0.5in inset. */
        body > ul ul,
        body > ul ol,
        body > ol ul,
        body > ol ol {
            margin-left: 0;
            margin-right: 0;
        }
        
        table.header,
        table.footer {
            padding-left: 0in;
            padding-right: 0in;
        }

        table {
            table-layout: fixed;
        }
        th {
            font-weight: bold;
            vertical-align: middle;
            padding: 5px 6px 3px;
            background-color: #e3e3e3;
            color: #333333;
        }
        td {
            padding: 4px 6px;
        }
		td p { align:left }
          
        .b {
            font-weight: bold;
        }
        table.header td {
            padding: 0;
        }
        table.footer td {
            padding: 0;
        }

        hr {
            width: 100%;
            color: #d3d3d3;
            background-color: #d3d3d3;
            height: 1px;
        }
        .section-header {
            font-size: 14pt;
            font-weight: bold;
        }
        
        .activo-items-table {
            width: 100%;
        }
        
        .activo-items-table th {
            font-weight: bold;
            vertical-align: middle;
            padding: 5px 6px 3px;
            background-color: #b93c3c;
            color: #fff;
        }

        .row-even { background-color: #ffffff; }
        .row-odd  { background-color: #f5f5f5; }

        .red-header {
            color: #b83c3c;
            font-size: 12pt;
        }

        td p.section-header {
            padding: 0;
        }

        .cover-table {
            width:100%;
            margin-top: 10px;
        }

        .cover-table td {
            align: right;
            font-size: 14px;
        }
        .cover-table td.header {
            font-size: 18px;
        }

    </style>
</head>
    <body
        header="firstpageheader"
        header-height="50%"
        footer="firstpagefooter"
        footer-height="20pt"
        size="Letter"
        padding="0.5in 0in 0.5in 0in">
        <!-- T L B R -->
    
    <!-- Page 1 - Cover page -->    

        <table class="cover-table">
            <tr><td class="header b">Quote Prepared For: Test</td></tr>
            <tr><td class="b">${record.entity}</td></tr>
            <tr><td style="text-align: right;">${record.billaddress}</td></tr>
            <tr><td>Email: ${companyinformation.email}</td></tr>
        </table>

        <table class="cover-table">
            <tr><td class="header b">Quote Prepared By:</td></tr>
            <tr><td>Email: ${user.email}</td></tr>
            <tr><td>Phone: ${user.mobilephone}</td></tr>
        </table>

        <#if record.title?has_content>
            <table class="cover-table">
                <tr><td class="header b">${record.title}</td></tr>
                <tr><td>${record@title} # ${record.tranid}</td></tr>
                <!-- <tr><td align="right" style="font-size: 14pt;">Version</td></tr> -->
            </table>    
        </#if>

    <!-- End of Page 1 -->

    <!-- Forced page break after page 1  -->
    <pbr 
        header="mainheader" 
        header-height="1.75in" 
        footer="mainfooter" 
        footer-height="0.1in"
         >
        <!-- T L B R -->
    </pbr>
    
    <!-- Page 2 - Introductory Letter  -->
    <#if record.custbody_nscpq_proposal_cover_letter?has_content>
        ${record.custbody_nscpq_proposal_cover_letter}    
        <!-- Forced page break after page 2  -->
        <pbr 
            header="mainheader" 
            header-height="1.75in" 
            footer="mainfooter" 
            footer-height="0.1in"
            >
            <!-- T L B R -->
        </pbr>
    </#if>
    <!-- End of Page 2 -->



    <#if record.custbody_nscpq_proposal_sow?has_content>
        <p class="section-header">Statement of Work</p>
        ${record.custbody_nscpq_proposal_sow}
        <p style="margin-bottom:15px;"></p>
        <pbr 
            header="mainheader" 
            header-height="1.75in" 
            footer="mainfooter" 
            footer-height="0.1in"
            >
            <!-- T L B R -->
        </pbr>
    </#if>

    <#if record.custbody_nscpq_proposal_tcs?has_content>    
        <p class="section-header">Terms and Conditions</p>
        ${record.custbody_nscpq_proposal_tcs}
        <p style="margin-bottom:15px;"></p>
        <pbr 
            header="mainheader" 
            header-height="1.75in" 
            footer="mainfooter" 
            footer-height="0.1in"
            >
            <!-- T L B R -->
        </pbr>
    </#if>

        <#if record.item?has_content>


            <!-- BEGIN: Grouped Items by custcol_cpq_subsection -->
            <!-- 1. Collect all unique group values and their totals in a single pass -->
            <#assign groupTotals = {} />
            <#assign laborTotals = {} />
            <#list record.item as item>
                <#assign groupKey = item.custcol_cpq_subsection?has_content?then(item.custcol_cpq_subsection, '(Ungrouped)')>
                <#assign currentTotal = (groupTotals[groupKey])!0>
                <#assign groupTotals = groupTotals + { groupKey : currentTotal + (item.amount)!0 } >
                <#assign currentLabor = (laborTotals[groupKey])!0>
                <#if false>
                    <#assign laborTotals = laborTotals + { groupKey : currentLabor + (item.amount)!0 } >
                <#else>
                    <#assign laborTotals = laborTotals + { groupKey : currentLabor } >
                </#if>
            </#list>
            <#assign allGroups = groupTotals?keys>

        <!-- 2. Loop over all groups and display a full table for each -->
        <#list allGroups as groupVal>
            <table class="itemtable" style="width: 100%; margin-top: 16px;">
                <thead>
                    <tr class="group-header-label">
                        <td colspan="19" align="left">${groupVal}</td>
                        <#if record.custbody_cpq_summ_group_pricing?string == 'Yes' || record.custbody_cpq_summ_group_pricing?string == 'T'>
                            <td colspan="6" align="right">$${groupTotals[groupVal]?string["#,##0.00"]}</td>
                        <#else>
                            <td colspan="6" align="right"></td>
                        </#if>
                    </tr>
                    <tr>
                        <th colspan="3" align="center">${record.item[0].quantity@label}</th>
                        <th colspan="17">${record.item[0].item@label}</th>

                        <#if record.custbody_cpq_itemized_pricing?string == 'Yes' || record.custbody_cpq_itemized_pricing?string == 'T'>
                            <th colspan="5" align="right">${record.item[0].amount@label}</th>
                        <#else>
                            <th colspan="5" align="right"></th>
                        </#if>
                        
                    </tr>
                </thead>
                <tbody>
                    <#list record.item as item>
                        <#assign currentGroup = item.custcol_cpq_subsection?has_content?then(item.custcol_cpq_subsection, '(Ungrouped)')>
                        <#if currentGroup == groupVal && true>
                            <tr>
                                <td colspan="3" line-height="150%" align="center">${item.quantity}</td>
                                <td colspan="17"><span class="itemname">${item.item}</span><br />${item.description}</td>
                                <#if record.custbody_cpq_itemized_pricing?string == 'Yes' || record.custbody_cpq_itemized_pricing?string == 'T'>
                                    <td colspan="5" align="right">${item.amount}</td>
                                <#else>
                                    <td colspan="5" align="right"></td>
                                </#if>
                            </tr>
                        </#if>
                    </#list>
                </tbody>
            </table>

            <#if laborTotals[groupVal] gt 0>
                <p style="padding:0px;margin:0px;font-weight: bold;">Labor:</p>
                <table class="itemtable" style="width: 100%;">
                    <thead>
                        <tr>
                            <th colspan="19" align="left">Description</th>
                            <th colspan="6" align="right">Ext. Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="19" align="left">Labor</td>
                            <td colspan="6" align="right">$${laborTotals[groupVal]?string["#,##0.00"]}</td>
                        </tr>
                    </tbody>
                </table>
            </#if>

        </#list>
        <!-- END: Grouped Items by custcol_nscpq_item_grouping -->

            <!-- BOM TABLE LAYOUT  -->
            <#if record.custbody_nscpq_proposal_bom_driven_sow>
                <table class="activo-items-table-bom-view" style="width: 100%; margin-top: 10px;">
                    <!-- start items -->
                    <#list record.item as item>
                        <tr>
                            <#if item.item == 'Description'>
                                <td colspan="15">${item.description}</td>
                            <#else>
                                <td colspan="2" align="center">${item.quantity}</td>
                                <td colspan="1" line-height="150%">X</td>
                                <td colspan="12">${item.description}</td>
                            </#if>
                        </tr>
                    </#list>
                    <!-- end items -->
                </table>

                <!-- Detailed Table View BOM -->
                <#else>
                <table class="activo-items-table" style="width: 100%; margin-top: 10px;">
                    <!-- start items -->
                    <#list record.item as item>
                        <#if item_index==0>
                            <thead>
                            <tr>
                                <#if !record.custbody_nscpq_proposal_no_pn>
                                    <th colspan="4">Part Number</th>
                                </#if>
                                <th colspan="12">Description</th>

                                <#if !record.custbody_nscpq_prosposal_no_pricing>
                                    <th colspan="3" align="right">Price</th>
                                </#if>
                                <th colspan="2" align="center">Qty</th>
                                
                                <#if !record.custbody_nscpq_prosposal_no_pricing>
                                    <th colspan="3" align="right">Ext. Price</th>
                                </#if>

                            </tr>
                            </thead>
                        </#if>
                        <tr class="${((item_index % 2) == 0)?string('row-even', 'row-odd')}">

                            
                            <#if item.item == 'Description'>
                                <td colspan="24" style="border: 1px solid black;">${item.description}</td>
                            <#else>
                                <#if !record.custbody_nscpq_proposal_no_pn>
                                    <td colspan="4" line-height="150%">${item.item}</td>
                                </#if>

                                <td colspan="12">${item.description}</td>

                                <#if !record.custbody_nscpq_prosposal_no_pricing>
                                    <td colspan="3" align="right">${item.rate}</td>
                                </#if>

                                <td colspan="2" align="center">${item.quantity}</td>
                                
                                <#if !record.custbody_nscpq_prosposal_no_pricing>
                                    <td colspan="3" align="right">${item.amount}</td>
                                </#if>
                            </#if>
                        </tr>
                    </#list>
                    <!-- end items -->
                </table>
                <hr />
            </#if>
        </#if>

    <!-- End items content -->
        <pbr 
            header="mainheader" 
            header-height="1.75in" 
            footer="mainfooter" 
            footer-height="0.1in"
            >
            <!-- T L B R -->
        </pbr>



    <!-- Prepared by: Prepared for: Quote Information: -->
    <table style="width:100%; border-bottom: 5px solid #b83c3c; padding-bottom: 15px;">
        <tr>
            <td class="red-header">Prepared by:</td>
            <td class="red-header">Prepared for:</td>
            <td class="red-header">Quote Information:</td>
        </tr>
        <tr>
            <td style="font-weight:bold;">Activo</td>
            <td style="font-weight:bold;">${record.entity}</td>
            <td style="font-weight:bold;">Quote #: ${record.tranid}</td>
        </tr>
        <tr>
            <td>${subsidiary.mainaddress_text}</td>
            <td>${record.billaddress}</td>
            <td>Version: []</td>
        </tr>
    </table>

    
    <!-- Project Investment Only, No Signature -->
    <#if record.custbody_nscpq_proposal_pi_no_sig>
    <p class="section-header">Project Investment</p>
    <p>The project investment is based on the documentation provided by ${record.entity} and information gathered by Activo through the needs analysis discovery.  Activo has interpreted the information and prepared this proposal to address ${record.entity} requirements.</p>
    
    <table style="width:100%; border-bottom: 5px solid #b83c3c; padding-bottom: 15px;">
        <tr>
            <td align="left" class="section-header" style="border:1px solid black;">Total Project Investment</td>
            <td align="right"><p class="section-header">${record.total}</p></td>
        </tr>
    </table>

        
    <!-- Project Investment Only, With Signature -->
    <#elseif record.custbody_nscpq_proposal_incl_sig_line>
    <p class="section-header">Project Investment</p>
    <p>The project investment is based on the documentation provided by ${record.entity} and information gathered by Activo through the needs analysis discovery.  Activo has interpreted the information and prepared this proposal to address ${record.entity} requirements.</p>

    
    <table style="width:100%; border-bottom: 5px solid #b83c3c; padding-bottom: 15px;">
        <tr>
            <td align="left" style="border:1px solid black;"><p class="section-header">Total Project Investment</p></td>
            <td align="right"><p class="section-header">${record.total}</p></td>
        </tr>
    </table>

    <!-- Signature Section  -->
    <table style="width: 100%;">
        <tr>
            <td style="width: 15%">Signature:</td>
            <td style="width: 35%; border-bottom: 1px solid black;"></td>
            <td style="width: 15%">Signature:</td>
            <td style="width: 35%; border-bottom: 1px solid black;"></td>
        </tr>
        <tr>
            <td>Name:</td>
            <td style="border-bottom: 1px solid black;"></td>
            <td>Name:</td>
            <td style="border-bottom: 1px solid black;"></td>
        </tr>
        <tr>
            <td>Title:</td>
            <td style="border-bottom: 1px solid black;"></td>
            <td>Title:</td>
            <td style="border-bottom: 1px solid black;"></td>
        </tr>
        <tr>
            <td>Date:</td>
            <td style="border-bottom: 1px solid black;"></td>
            <td>Date:</td>
            <td style="border-bottom: 1px solid black;"></td>
        </tr>
    </table>

    <!-- Detailed Summary, No Signature -->
    <#elseif record.custbody_nscpq_proposal_ds_no_sig>
    <p>Detailed Summary, No Signature</p>

    <!-- Detailed Summary with Signature and Optional Pricing -->
    <#elseif record.custbody_nscpq_proposal_ds_sig_options>
    <p> Detailed Summary with Signature and Optional Pricing</p>

    <!-- Signature Section  -->
    <table style="width: 100%;">
        <tr>
            <td style="width: 15%">Signature:</td>
            <td style="width: 35%; border-bottom: 1px solid black;"></td>
            <td style="width: 15%">Signature:</td>
            <td style="width: 35%; border-bottom: 1px solid black;"></td>
        </tr>
        <tr>
            <td>Name:</td>
            <td style="border-bottom: 1px solid black;"></td>
            <td>Name:</td>
            <td style="border-bottom: 1px solid black;"></td>
        </tr>
        <tr>
            <td>Title:</td>
            <td style="border-bottom: 1px solid black;"></td>
            <td>Title:</td>
            <td style="border-bottom: 1px solid black;"></td>
        </tr>
        <tr>
            <td>Date:</td>
            <td style="border-bottom: 1px solid black;"></td>
            <td>Date:</td>
            <td style="border-bottom: 1px solid black;"></td>
        </tr>
    </table>

    </#if>


</body>
</pdf>

    <#if record.custbody_supporting_pdfs?has_content>
        <#list record.custbody_supporting_pdfs?split(",") as pdfUrl>
            <pdf src="${pdfUrl}"/>
        </#list>
    </#if> 

</pdfset>